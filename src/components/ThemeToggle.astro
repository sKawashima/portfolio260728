<button id="theme-toggle" type="button" aria-label="テーマ切り替え">
  <span class="icon-light" aria-hidden="true">☀</span>
  <span class="icon-dark" aria-hidden="true">☾</span>
</button>

<style>
  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-card);
    color: var(--color-accent);
    font-size: 16px;
    cursor: pointer;
  }

  #theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .icon-dark {
    display: none;
  }

  :global([data-theme='dark']) .icon-light {
    display: none;
  }

  :global([data-theme='dark']) .icon-dark {
    display: inline;
  }

  /* テーマ未保存時はOS設定に追従してアイコンを切り替える */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .icon-light {
      display: none;
    }

    :global(html:not([data-theme])) .icon-dark {
      display: inline;
    }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle')
  toggle?.addEventListener('click', () => {
    const root = document.documentElement
    const current =
      root.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    const next = current === 'dark' ? 'light' : 'dark'
    root.dataset.theme = next
    localStorage.setItem('theme', next)
  })
</script>
