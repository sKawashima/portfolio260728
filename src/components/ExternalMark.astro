---
// 外部サイト(note)の記事であることを示すバッジ。
// 一覧の `.meta` 行やArchivesの行内に置く前提で、文字サイズは親に合わせる
interface Props {
  site?: string
}

const { site = 'note' } = Astro.props
---

<span class="external-mark">
  {site}
  <svg class="icon" viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">
    <path
      d="M6 3h7v7M13 3 3 13"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span class="sr-only">(外部サイトへ移動)</span>
</span>

<style>
  .external-mark {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--color-chip-bg);
    color: var(--color-chip-text);
    font-size: 0.92em;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.6;
    white-space: nowrap;
  }

  .icon {
    flex: 0 0 auto;
    width: 0.85em;
    height: 0.85em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
