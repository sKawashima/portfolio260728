---
import type { CollectionEntry } from 'astro:content'
import { blogPath, excerptOf, formatDate } from '../lib/blog'

interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class="post-item">
        <a href={blogPath(post)}>
          <p class="meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {post.data.category && <span class="category">{post.data.category}</span>}
          </p>
          <h2 class="title">{post.data.title}</h2>
          <p class="excerpt">{excerptOf(post)}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .post-item a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .meta {
    display: flex;
    gap: 12px;
    align-items: baseline;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .category {
    color: var(--color-text-sub);
  }

  .title {
    margin: 6px 0 8px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.5;
  }

  .post-item a:hover .title {
    color: var(--color-accent);
  }

  .excerpt {
    color: var(--color-text-sub);
    font-size: 14px;
    line-height: 1.8;
  }
</style>
