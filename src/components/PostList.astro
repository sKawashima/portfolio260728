---
import type { FeedEntry } from '../lib/blog'
import { formatDate } from '../lib/blog'
import ExternalMark from './ExternalMark.astro'

interface Props {
  entries: FeedEntry[]
}

const { entries } = Astro.props
---

<ul class="post-list">
  {
    entries.map((entry) => (
      <li class="post-item">
        <a
          href={entry.href}
          target={entry.kind === 'note' ? '_blank' : undefined}
          rel={entry.kind === 'note' ? 'noopener noreferrer' : undefined}
        >
          <p class="meta">
            <time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>
            {entry.kind === 'note' ? (
              <ExternalMark />
            ) : (
              entry.label && <span class="category">{entry.label}</span>
            )}
          </p>
          <h2 class="title">{entry.title}</h2>
          <p class="excerpt">{entry.excerpt}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .post-item a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .meta {
    display: flex;
    gap: 12px;
    align-items: baseline;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .category {
    color: var(--color-text-sub);
  }

  .title {
    margin: 6px 0 8px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.5;
  }

  .post-item a:hover .title {
    color: var(--color-accent);
  }

  .excerpt {
    color: var(--color-text-sub);
    font-size: 14px;
    line-height: 1.8;
  }
</style>
