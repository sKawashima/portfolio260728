---
import SK from './SK.astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header>
  <a class="brand" href="/">
    <span class="logo"><SK /></span>
    <span class="name">sKawashima's Portfolio</span>
  </a>
  <ThemeToggle />
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1040px;
    margin: 0 auto;
    padding: 16px 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand:hover .name {
    color: var(--color-accent);
  }

  .logo {
    width: 22px;
    height: 25px;
    display: block;
  }

  .name {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
</style>
