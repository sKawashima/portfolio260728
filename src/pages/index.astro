---
import { getCollection } from 'astro:content'
import Footer from '../components/Footer.astro'
import SiteHeader from '../components/SiteHeader.astro'
import WorksGrid from '../components/WorksGrid.astro'
import Layout from '../layouts/Layout.astro'
import { blogPath, formatDate, sortedBlogPosts } from '../lib/blog'

const works = await getCollection('works')
const recentWorks = works.sort((a, b) => b.data.sortDate - a.data.sortDate).slice(0, 6)
const recentPosts = (await sortedBlogPosts()).slice(0, 3)
---

<Layout title="sKawashima Portfolio">
  <SiteHeader />
  <section class="hero">
    <p class="eyebrow">Design · Development · Art</p>
    <h1>s<span class="b">K</span>awashima's<br />Portfolio</h1>
    <div class="bar"></div>
    <p class="lede">デザインと開発とアートの間でざくざくやってます。</p>
  </section>
  <section class="digest">
    <div class="inner">
      <div class="digest-head">
        <h2>Works</h2>
        <a class="more" href="/works/">View all →</a>
      </div>
      <WorksGrid works={recentWorks} />
    </div>
  </section>
  <section class="digest">
    <div class="inner">
      <div class="digest-head">
        <h2>Blog</h2>
        <a class="more" href="/blog/">View all →</a>
      </div>
      <ul class="blog-list">
        {
          recentPosts.map((post) => (
            <li>
              <a href={blogPath(post)}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <span class="post-title">{post.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .hero {
    max-width: 1040px;
    margin: 0 auto;
    padding: 64px 24px 80px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  h1 {
    margin: 12px 0 20px;
    font-family: var(--font-display);
    font-size: clamp(44px, 8vw, 76px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.01em;
  }

  h1 .b {
    font-family: var(--font-display-heavy);
  }

  .bar {
    width: 120px;
    height: 4px;
    background: var(--color-accent);
  }

  .lede {
    margin-top: 20px;
    color: var(--color-text-sub);
  }

  .digest {
    padding: 0 0 112px;
  }

  .inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .digest-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .digest-head h2 {
    color: var(--color-accent-strong);
    font-family: var(--font-display-thin);
    font-size: 36px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .more {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .more:hover {
    text-decoration: underline;
  }

  .blog-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .blog-list a {
    display: flex;
    gap: 16px;
    align-items: baseline;
    color: inherit;
    text-decoration: none;
  }

  .blog-list time {
    flex: 0 0 auto;
    color: var(--color-text-sub);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .blog-list .post-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.6;
  }

  .blog-list a:hover .post-title {
    color: var(--color-accent);
  }

  @media screen and (max-width: 640px) {
    .blog-list a {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
