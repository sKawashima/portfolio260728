---
import { getCollection } from 'astro:content'
import Footer from '../components/Footer.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SK from '../components/SK.astro'
import WorksGrid from '../components/WorksGrid.astro'
import Layout from '../layouts/Layout.astro'

const works = await getCollection('works')
const recentWorks = works.sort((a, b) => b.data.sortDate - a.data.sortDate).slice(0, 6)
---

<Layout title="sKawashima Portfolio">
  <SiteHeader />
  <section class="hero">
    <div class="logo"><SK /></div>
    <p class="eyebrow">Design · Development · Art</p>
    <h1>sKawashima's<br />Portfolio</h1>
    <div class="bar"></div>
    <p class="lede">デザインと開発とアートの間でざくざくやってます。</p>
  </section>
  <section class="digest">
    <div class="inner">
      <div class="digest-head">
        <h2>Works</h2>
        <a class="more" href="/works/">すべての作品を見る →</a>
      </div>
      <WorksGrid works={recentWorks} />
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .hero {
    max-width: 1040px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .logo {
    width: 72px;
    height: 82px;
    margin-bottom: 24px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  h1 {
    margin: 12px 0 20px;
    font-size: clamp(40px, 8vw, 72px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .bar {
    width: 120px;
    height: 4px;
    background: var(--color-accent);
  }

  .lede {
    margin-top: 20px;
    color: var(--color-text-sub);
  }

  .digest {
    padding: 0 0 112px;
  }

  .inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .digest-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .digest-head h2 {
    color: var(--color-accent-strong);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .more {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
