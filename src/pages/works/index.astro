---
import { getCollection } from 'astro:content'
import Footer from '../../components/Footer.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import WorksGrid from '../../components/WorksGrid.astro'
import Layout from '../../layouts/Layout.astro'

const works = await getCollection('works')
const sortedWorks = works.sort((a, b) => b.data.sortDate - a.data.sortDate)
---

<Layout title="Works | sKawashima Portfolio">
  <SiteHeader />
  <section class="works">
    <div class="inner">
      <h1 class="heading">Works</h1>
      <div class="bar"></div>
      <WorksGrid works={sortedWorks} />
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .works {
    padding: 32px 0 112px;
  }

  .inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .heading {
    color: var(--color-accent-strong);
    font-family: var(--font-display-thin);
    font-size: 44px;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 16px;
  }

  .bar {
    width: 80px;
    height: 4px;
    background: var(--color-accent);
    margin-bottom: 40px;
  }
</style>
