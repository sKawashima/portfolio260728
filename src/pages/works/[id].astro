---
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import Footer from '../../components/Footer.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const works = await getCollection('works')
  return works.map((work) => ({
    params: { id: work.id },
    props: { work },
  }))
}

const { work } = Astro.props
const {
  title,
  genres,
  activity,
  memberCount,
  role,
  period,
  date,
  technologies,
  thumbnail,
  youtubeId,
  link,
} = work.data
const { Content } = await render(work)

const details = [
  ['活動', activity],
  ['活動人数', memberCount],
  ['担当', role],
  ['制作期間', period],
  ['制作時期', date],
  ['使用技術', technologies],
]
---

<Layout title={`${title} | sKawashima Portfolio`} description={`${title} — sKawashimaの制作物(${date})`}>
  <SiteHeader />
  <article class="work">
    <div class="head">
      <div class="chips">
        {genres.map((genre) => <span class="chip">{genre.name}</span>)}
      </div>
      <h1>{title}</h1>
      <div class="bar"></div>
    </div>
    {
      youtubeId ? (
        <div class="media media-youtube">
          <iframe
            src={`https://www.youtube.com/embed/${youtubeId}?rel=0`}
            title={title}
            loading="lazy"
            allow="autoplay; encrypted-media"
            allowfullscreen
          />
        </div>
      ) : thumbnail ? (
        <div class="media">
          <Image src={thumbnail} alt={title} width={1200} densities={[1, 2]} format="webp" />
        </div>
      ) : null
    }
    <div class="content">
      <aside class="side">
        <dl class="details">
          {
            details.map(([label, value]) => (
              <>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </>
            ))
          }
        </dl>
      </aside>
      <div class="main">
        <div class="summary">
          <Content />
        </div>
        {
          link && (
            <a class="external" href={link} target="_blank" rel="noopener noreferrer">
              サイトを見る ↗
            </a>
          )
        }
      </div>
    </div>
  </article>
  <Footer />
</Layout>

<style>
  .work {
    /* ワイド画面ではメタ情報をサイドバー化する2カラム構成(下のメディアクエリ参照) */
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 24px 96px;
  }

  .head {
    margin-bottom: 32px;
  }

  .chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .chip {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--color-chip-bg);
    color: var(--color-chip-text);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  h1 {
    font-size: clamp(26px, 5vw, 40px);
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .bar {
    width: 80px;
    height: 4px;
    background: var(--color-accent);
  }

  .media {
    margin-bottom: 32px;
  }

  .media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
  }

  .media-youtube {
    aspect-ratio: 16 / 9;
  }

  .media-youtube iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 6px;
  }

  .details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 20px;
    font-size: 14px;
    margin-bottom: 48px;
  }

  @media screen and (min-width: 1100px) {
    .content {
      display: grid;
      grid-template-columns: 300px minmax(0, 1fr);
      gap: 24px 56px;
      align-items: start;
    }

    .side {
      position: sticky;
      top: 24px;
    }

    .details {
      margin-bottom: 0;
    }

    /* 基本ルールの .details dt(右揃え)より詳細度を上げて上書きする */
    .content .details dt {
      text-align: left;
    }
  }

  .details dt {
    color: var(--color-text-sub);
    text-align: right;
  }

  .details dd {
    margin: 0;
  }

  .summary {
    line-height: 1.9;
  }

  .external {
    display: inline-block;
    margin-top: 32px;
    padding: 10px 24px;
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .external:hover {
    background: var(--color-accent);
    color: var(--color-bg);
  }
</style>
