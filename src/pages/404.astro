---
import Footer from '../components/Footer.astro'
import SiteHeader from '../components/SiteHeader.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="404 Not Found | sKawashima Portfolio" description="お探しのページは見つかりませんでした。">
  <SiteHeader />
  <section class="notfound">
    <p class="eyebrow">404 Not Found</p>
    <h1>Page<br />not found.</h1>
    <div class="bar"></div>
    <p class="lede">お探しのページは見つかりませんでした。移動または削除された可能性があります。</p>
    <nav class="links">
      <a href="/">← トップへ戻る</a>
      <a href="/works/">Works</a>
      <a href="/blog/">Blog</a>
    </nav>
  </section>
  <Footer />
</Layout>

<style>
  .notfound {
    max-width: 1040px;
    margin: 0 auto;
    padding: 64px 24px 112px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  h1 {
    margin: 12px 0 20px;
    font-family: var(--font-display);
    font-size: clamp(44px, 8vw, 76px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.01em;
  }

  .bar {
    width: 120px;
    height: 4px;
    background: var(--color-accent);
  }

  .lede {
    margin-top: 20px;
    color: var(--color-text-sub);
  }

  .links {
    display: flex;
    gap: 24px;
    margin-top: 32px;
  }

  .links a {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
