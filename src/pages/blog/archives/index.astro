---
import BlogPageShell from '../../../components/BlogPageShell.astro'
import ExternalMark from '../../../components/ExternalMark.astro'
import { blogYearMonth, formatDate, sortedBlogFeed } from '../../../lib/blog'

// ローカル記事 + note 記事(外部リンク)を年ごとにまとめる
const entries = await sortedBlogFeed()
const byYear = new Map<string, typeof entries>()
for (const entry of entries) {
  const { year } = blogYearMonth(entry.date)
  const group = byYear.get(year) ?? []
  group.push(entry)
  byYear.set(year, group)
}
const years = [...byYear.entries()]
---

<BlogPageShell title="Archives | sKawashima's blog" heading="Archives" lead={`全${entries.length}記事`}>
  {
    years.map(([year, yearEntries]) => (
      <section class="year">
        <h2>{year}</h2>
        <ul>
          {yearEntries.map((entry) => (
            <li>
              <time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>
              <a
                href={entry.href}
                target={entry.kind === 'note' ? '_blank' : undefined}
                rel={entry.kind === 'note' ? 'noopener noreferrer' : undefined}
              >
                {entry.title}
                {entry.kind === 'note' && <ExternalMark />}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BlogPageShell>

<style>
  .year {
    margin-bottom: 40px;
  }

  .year h2 {
    color: var(--color-accent-strong);
    font-family: var(--font-display-thin);
    font-size: 28px;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 16px;
  }

  .year ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .year li {
    display: flex;
    gap: 16px;
    align-items: baseline;
  }

  .year time {
    flex: 0 0 auto;
    color: var(--color-text-sub);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .year a {
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.6;
  }

  .year a:hover {
    color: var(--color-accent);
  }

  .year a :global(.external-mark) {
    margin-left: 8px;
    font-size: 12px;
    vertical-align: 0.1em;
  }
</style>
