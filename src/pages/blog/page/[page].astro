---
import BlogPageShell from '../../../components/BlogPageShell.astro'
import BlogTaxonomy from '../../../components/BlogTaxonomy.astro'
import Pagination from '../../../components/Pagination.astro'
import PostList from '../../../components/PostList.astro'
import { PER_PAGE, sortedBlogFeed } from '../../../lib/blog'

export async function getStaticPaths() {
  const entries = await sortedBlogFeed()
  const totalPages = Math.ceil(entries.length / PER_PAGE)
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2
    return {
      params: { page: String(page) },
      props: {
        entries: entries.slice((page - 1) * PER_PAGE, page * PER_PAGE),
        page,
        totalPages,
      },
    }
  })
}

const { entries, page, totalPages } = Astro.props
---

<BlogPageShell title={`Blog - Page ${page} | sKawashima's blog`} heading="Blog" lead={`Page ${page} / ${totalPages}`}>
  <PostList entries={entries} />
  <Pagination current={page} total={totalPages} />
  <BlogTaxonomy />
</BlogPageShell>
