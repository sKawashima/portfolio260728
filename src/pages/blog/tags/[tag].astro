---
import BlogPageShell from '../../../components/BlogPageShell.astro'
import PostList from '../../../components/PostList.astro'
import { slugifyTerm, sortedBlogPosts } from '../../../lib/blog'

export async function getStaticPaths() {
  const posts = await sortedBlogPosts()
  const byTag = new Map<string, { name: string; posts: typeof posts }>()
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTerm(tag)
      const group = byTag.get(slug) ?? { name: tag, posts: [] }
      group.posts.push(post)
      byTag.set(slug, group)
    }
  }
  return [...byTag.entries()].map(([slug, group]) => ({
    params: { tag: slug },
    props: { name: group.name, posts: group.posts },
  }))
}

const { name, posts } = Astro.props
---

<BlogPageShell title={`#${name} | sKawashima's blog`} heading={`#${name}`} lead={`${posts.length}件の記事`}>
  <PostList posts={posts} />
  <p class="back"><a href="/blog/tags/">← すべてのタグ</a></p>
</BlogPageShell>

<style>
  .back {
    margin-top: 48px;
    font-size: 14px;
  }

  .back a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .back a:hover {
    text-decoration: underline;
  }
</style>
