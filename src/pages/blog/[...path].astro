---
import { render } from 'astro:content'
import Footer from '../../components/Footer.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import Layout from '../../layouts/Layout.astro'
import { blogPath, blogYearMonth, formatDate, slugifyTerm, sortedBlogPosts } from '../../lib/blog'

export async function getStaticPaths() {
  const posts = await sortedBlogPosts()
  return posts.map((post, index) => {
    const { year, month } = blogYearMonth(post.data.date)
    return {
      params: { path: `${year}/${month}/${post.id}` },
      props: {
        post,
        // 新しい順に並んでいるので、prev = 1つ新しい記事 / next = 1つ古い記事
        newer: posts[index - 1] ?? null,
        older: posts[index + 1] ?? null,
      },
    }
  })
}

const { post, newer, older } = Astro.props
const { title, date, category, tags } = post.data
const { Content, headings } = await render(post)

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const dateLabel = formatDate(date)
---

<Layout title={`${title} | sKawashima's blog`} description={title}>
  <SiteHeader />
  <article class="post">
    <div class="head">
      <p class="meta">
        <time datetime={date.toISOString()}>{dateLabel}</time>
        {category && <span class="category">{category}</span>}
      </p>
      <h1>{title}</h1>
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((tag) => (
              <a class="tag" href={`/blog/tags/${slugifyTerm(tag)}/`}>
                #{tag}
              </a>
            ))}
          </p>
        )
      }
      <div class="bar"></div>
    </div>
    {
      toc.length >= 2 && (
        <nav class="toc" aria-label="目次">
          <p class="toc-label">目次</p>
          <ul>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="body">
      <Content />
    </div>
    <nav class="post-nav" aria-label="前後の記事">
      {
        newer ? (
          <a class="post-nav-link newer" href={blogPath(newer)}>
            <span class="dir">← 新しい記事</span>
            <span class="post-title">{newer.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        older ? (
          <a class="post-nav-link older" href={blogPath(older)}>
            <span class="dir">古い記事 →</span>
            <span class="post-title">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
    <p class="backlink"><a href="/blog/">← Blog トップ</a></p>
  </article>
  <Footer />
</Layout>

<style>
  .post {
    max-width: var(--width-prose);
    margin: 0 auto;
    padding: 24px 24px 96px;
  }

  .head {
    margin-bottom: 40px;
  }

  .meta {
    display: flex;
    gap: 12px;
    align-items: baseline;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .category {
    color: var(--color-text-sub);
  }

  h1 {
    margin: 10px 0 12px;
    font-size: clamp(24px, 4.5vw, 34px);
    font-weight: 800;
    line-height: 1.5;
  }

  .tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .tag {
    color: var(--color-text-sub);
    font-size: 13px;
    text-decoration: none;
  }

  .tag:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .bar {
    width: 80px;
    height: 4px;
    background: var(--color-accent);
  }

  .toc {
    margin: 0 0 40px;
    padding: 20px 24px;
    background: var(--color-bg-section);
    border-radius: 6px;
  }

  .toc-label {
    color: var(--color-accent-strong);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 10px;
  }

  .toc ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .toc a {
    color: var(--color-text);
    font-size: 14px;
    text-decoration: none;
    line-height: 1.6;
  }

  .toc a:hover {
    color: var(--color-accent);
  }

  .toc .depth-3 {
    padding-left: 1.2em;
  }

  .toc .depth-3 a {
    color: var(--color-text-sub);
  }

  .body {
    line-height: 1.9;
  }

  .body :global(h2) {
    margin: 48px 0 16px;
    padding-left: 12px;
    border-left: 4px solid var(--color-accent);
    font-size: 22px;
    line-height: 1.5;
  }

  .body :global(h3) {
    margin: 36px 0 12px;
    font-size: 19px;
    line-height: 1.5;
  }

  .body :global(h4) {
    margin: 28px 0 10px;
    font-size: 16px;
  }

  .body :global(p) {
    margin: 0 0 1.2em;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.6em;
  }

  .body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .body :global(pre) {
    padding: 16px 20px;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.7;
    margin: 0 0 1.2em;
  }

  .body :global(:not(pre) > code) {
    background: var(--color-code-bg);
    color: var(--color-code-text);
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 1px 6px;
    border-radius: 4px;
  }

  .body :global(blockquote) {
    margin: 0 0 1.2em;
    padding: 4px 0 4px 16px;
    border-left: 3px solid var(--color-border);
    color: var(--color-text-sub);
  }

  .body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 40px 0;
  }

  .body :global(table) {
    border-collapse: collapse;
    margin: 0 0 1.2em;
    display: block;
    overflow-x: auto;
  }

  .body :global(th),
  .body :global(td) {
    border: 1px solid var(--color-border);
    padding: 6px 12px;
  }

  .body :global(.youtube-embed) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 6px;
    margin: 0 0 1.2em;
  }

  .body :global(.code-title) {
    display: inline-block;
    margin-bottom: -0.4em;
    padding: 4px 14px;
    border-radius: 6px 6px 0 0;
    background: var(--color-chip-bg);
    color: var(--color-chip-text);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }

  .body :global(.link-card) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0 0 1.2em;
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: border-color 0.15s ease;
  }

  .body :global(.link-card:hover) {
    border-color: var(--color-accent);
  }

  .body :global(.link-card-host) {
    color: var(--color-text);
    font-size: 14px;
    font-weight: 700;
  }

  .body :global(.link-card-url) {
    color: var(--color-text-sub);
    font-size: 12px;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px;
    border-radius: 8px;
    background: var(--color-bg-section);
    text-decoration: none;
  }

  .post-nav-link.older {
    text-align: right;
  }

  .post-nav-link .dir {
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 600;
  }

  .post-nav-link .post-title {
    color: var(--color-text);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .post-nav-link:hover .post-title {
    color: var(--color-accent);
  }

  @media screen and (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
  }

  .backlink {
    margin-top: 32px;
    font-size: 14px;
  }

  .backlink a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .backlink a:hover {
    text-decoration: underline;
  }
</style>
