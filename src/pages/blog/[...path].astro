---
import { getCollection, render } from 'astro:content'
import Footer from '../../components/Footer.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import Layout from '../../layouts/Layout.astro'
import { blogYearMonth } from '../../lib/blog'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => {
    const { year, month } = blogYearMonth(post.data.date)
    return {
      params: { path: `${year}/${month}/${post.id}` },
      props: { post },
    }
  })
}

const { post } = Astro.props
const { title, date, category, tags } = post.data
const { Content } = await render(post)

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(date)
---

<Layout title={`${title} | sKawashima's blog`} description={title}>
  <SiteHeader />
  <article class="post">
    <div class="head">
      <p class="meta">
        <time datetime={date.toISOString()}>{dateLabel}</time>
        {category && <span class="category">{category}</span>}
      </p>
      <h1>{title}</h1>
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </p>
        )
      }
      <div class="bar"></div>
    </div>
    <div class="body">
      <Content />
    </div>
  </article>
  <Footer />
</Layout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 24px 24px 96px;
  }

  .head {
    margin-bottom: 40px;
  }

  .meta {
    display: flex;
    gap: 12px;
    align-items: baseline;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .category {
    color: var(--color-text-sub);
  }

  h1 {
    margin: 10px 0 12px;
    font-size: clamp(24px, 4.5vw, 34px);
    font-weight: 800;
    line-height: 1.5;
  }

  .tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .tag {
    color: var(--color-text-sub);
    font-size: 13px;
  }

  .bar {
    width: 80px;
    height: 4px;
    background: var(--color-accent);
  }

  .body {
    line-height: 1.9;
  }

  .body :global(h2) {
    margin: 48px 0 16px;
    padding-left: 12px;
    border-left: 4px solid var(--color-accent);
    font-size: 22px;
    line-height: 1.5;
  }

  .body :global(h3) {
    margin: 36px 0 12px;
    font-size: 19px;
    line-height: 1.5;
  }

  .body :global(h4) {
    margin: 28px 0 10px;
    font-size: 16px;
  }

  .body :global(p) {
    margin: 0 0 1.2em;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.6em;
  }

  .body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .body :global(pre) {
    padding: 16px 20px;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.7;
    margin: 0 0 1.2em;
  }

  .body :global(:not(pre) > code) {
    background: var(--color-code-bg);
    color: var(--color-code-text);
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 1px 6px;
    border-radius: 4px;
  }

  .body :global(blockquote) {
    margin: 0 0 1.2em;
    padding: 4px 0 4px 16px;
    border-left: 3px solid var(--color-border);
    color: var(--color-text-sub);
  }

  .body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 40px 0;
  }

  .body :global(table) {
    border-collapse: collapse;
    margin: 0 0 1.2em;
    display: block;
    overflow-x: auto;
  }

  .body :global(th),
  .body :global(td) {
    border: 1px solid var(--color-border);
    padding: 6px 12px;
  }

  .body :global(.youtube-embed) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 6px;
    margin: 0 0 1.2em;
  }
</style>
